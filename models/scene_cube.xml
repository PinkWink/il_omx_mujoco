<!-- OMX follower on a table: pick the blue cube and place it in the green tray. -->
<mujoco model="omx cube to tray">
  <include file="omx_follower.xml"/>

  <statistic center="0.18 0.03 0.08" extent="0.5"/>

  <visual>
    <headlight diffuse="0.5 0.5 0.5" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global azimuth="150" elevation="-30" offwidth="640" offheight="480"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table" rgba="0.75 0.72 0.66 1"/>
    <material name="cube_blue" rgba="0.1 0.3 0.95 1"/>
    <material name="tray" rgba="0.2 0.7 0.3 1"/>
  </asset>

  <worldbody>
    <light pos="0.2 -0.3 1.2" dir="0 0.25 -1" directional="false" castshadow="true"/>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" castshadow="false" diffuse="0.3 0.3 0.3"/>
    <geom name="floor" pos="0 0 -0.75" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Table top surface is z = 0; the robot base sits at the origin. -->
    <geom name="table" type="box" pos="0.15 0 -0.02" size="0.35 0.4 0.02" material="table"
      friction="1 0.005 0.0001"/>

    <!-- Fixed third-person camera aimed at the workspace. -->
    <body name="workspace_center" pos="0.2 0.04 0.02"/>
    <camera name="global" pos="0.5 -0.28 0.38" mode="targetbody" target="workspace_center" fovy="50"/>

    <!-- 30 mm blue cube (about 25 g). Torsional friction (condim 4) keeps it from spinning out of the grip. -->
    <body name="cube" pos="0.2 -0.06 0.015">
      <freejoint name="cube_joint"/>
      <geom name="cube" type="box" size="0.015 0.015 0.015" mass="0.025" material="cube_blue"
        condim="4" friction="1.2 0.02 0.001" solref="0.004 1"/>
    </body>

    <!-- Target tray: 80 mm inner square with 12 mm walls. -->
    <body name="tray" pos="0.18 0.13 0">
      <geom name="tray_floor" type="box" pos="0 0 0.001" size="0.044 0.044 0.001" material="tray"/>
      <geom name="tray_wall_px" type="box" pos="0.042 0 0.006" size="0.002 0.044 0.006" material="tray"/>
      <geom name="tray_wall_nx" type="box" pos="-0.042 0 0.006" size="0.002 0.044 0.006" material="tray"/>
      <geom name="tray_wall_py" type="box" pos="0 0.042 0.006" size="0.04 0.002 0.006" material="tray"/>
      <geom name="tray_wall_ny" type="box" pos="0 -0.042 0.006" size="0.04 0.002 0.006" material="tray"/>
      <site name="tray_center" pos="0 0 0.002" size="0.005" rgba="1 1 1 0.3" group="4"/>
    </body>
  </worldbody>

  <keyframe>
    <!-- qpos: 5 arm joints, gripper, gripper mimic, cube free joint (xyz + quat). -->
    <key name="home" qpos="0 -0.3 0.1 1.3 0 0.8 -0.8  0.2 -0.06 0.015 1 0 0 0" ctrl="0 -0.3 0.1 1.3 0 0.8"/>
  </keyframe>
</mujoco>
